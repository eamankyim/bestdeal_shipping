# Caddy gets and renews the HTTPS certificates by itself once the domain points at this server.
# TEST_DOMAIN (optional) serves the same site on a second address, e.g. for checking a new
# server before the real domain is moved to it.

{$SITE_DOMAIN} {$TEST_DOMAIN} {
	encode zstd gzip

	# Photos are sent as part of the request; keep well above what the app sends
	request_body {
		max_size 25MB
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	handle /api/* {
		reverse_proxy backend:4000
	}

	handle {
		root * /srv
		# Built files have a content hash in their name, so they can be cached for good;
		# everything else (index.html) is checked again so a new release shows up at once
		@hashed {
			path /static/*
			file
		}
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		# Logo and pictures change rarely: browsers keep them for a week
		@images path *.png *.jpg *.jpeg *.ico *.svg *.webp
		header @images Cache-Control "public, max-age=604800"
		@other {
			not path /static/*
			not path *.png *.jpg *.jpeg *.ico *.svg *.webp
		}
		header @other Cache-Control "no-cache"
		# Any other address is a page of the app. A missing /static/ file is from an older release:
		# it gets a plain 404 (never the app's page in its place), and the app reloads itself
		@page {
			not path /static/*
			not file
		}
		rewrite @page /index.html
		# Files were compressed at full strength when the image was built (deploy/precompress.js)
		file_server {
			precompressed br gzip
		}
	}
}

www.{$SITE_DOMAIN} {
	redir https://{$SITE_DOMAIN}{uri} permanent
}
